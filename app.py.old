from flask import Flask, jsonify, redirect
from flask_sqlalchemy import SQLAlchemy
from flask_admin import Admin
from flask_admin.contrib.sqla import ModelView

app = Flask(__name__)

# Database configuration (update password if needed; consider using .env for security)
app.config['SQLALCHEMY_DATABASE_URI'] = 'postgresql://foodexpress:your_password@localhost/foodexpress'
app.config['SQLALCHEMY_TRACK_MODIFICATIONS'] = False
app.config['SECRET_KEY'] = 'your_secret_key'  # Required for Flask-Admin; change to a secure value

db = SQLAlchemy(app)

# Define models based on schema.sql
class Customer(db.Model):
    __tablename__ = 'customers'
    id = db.Column(db.Integer, primary_key=True)
    name = db.Column(db.String(100), nullable=False)
    email = db.Column(db.String(120), unique=True, nullable=False)
    phone = db.Column(db.String(20))
    address = db.Column(db.Text, nullable=False)
    created_at = db.Column(db.TIMESTAMP, default=db.func.current_timestamp())

class Restaurant(db.Model):
    __tablename__ = 'restaurants'
    id = db.Column(db.Integer, primary_key=True)
    name = db.Column(db.String(150), nullable=False)
    address = db.Column(db.Text, nullable=False)
    phone = db.Column(db.String(20))
    cuisine = db.Column(db.String(50))
    rating = db.Column(db.Numeric(2, 1), db.CheckConstraint('rating >= 0 AND rating <= 5'))

class MenuItem(db.Model):
    __tablename__ = 'menu_items'
    id = db.Column(db.Integer, primary_key=True)
    restaurant_id = db.Column(db.Integer, db.ForeignKey('restaurants.id', ondelete='CASCADE'))
    name = db.Column(db.String(100), nullable=False)
    description = db.Column(db.Text)
    price = db.Column(db.Numeric(8, 2), nullable=False)
    available = db.Column(db.Boolean, default=True)

class DeliveryPartner(db.Model):
    __tablename__ = 'delivery_partners'
    id = db.Column(db.Integer, primary_key=True)
    name = db.Column(db.String(100), nullable=False)
    phone = db.Column(db.String(20))
    vehicle_type = db.Column(db.String(50))
    status = db.Column(db.String(20), default='available')

class Order(db.Model):
    __tablename__ = 'orders'
    id = db.Column(db.Integer, primary_key=True)
    customer_id = db.Column(db.Integer, db.ForeignKey('customers.id', ondelete='CASCADE'))
    restaurant_id = db.Column(db.Integer, db.ForeignKey('restaurants.id', ondelete='CASCADE'))
    delivery_partner_id = db.Column(db.Integer, db.ForeignKey('delivery_partners.id', ondelete='SET NULL'))
    status = db.Column(db.String(20), default='placed')
    total_amount = db.Column(db.Numeric(10, 2))
    created_at = db.Column(db.TIMESTAMP, default=db.func.current_timestamp())

class OrderItem(db.Model):
    __tablename__ = 'order_items'
    id = db.Column(db.Integer, primary_key=True)
    order_id = db.Column(db.Integer, db.ForeignKey('orders.id', ondelete='CASCADE'))
    menu_item_id = db.Column(db.Integer, db.ForeignKey('menu_items.id', ondelete='CASCADE'))
    quantity = db.Column(db.Integer, db.CheckConstraint('quantity > 0'))
    price = db.Column(db.Numeric(8, 2), nullable=False)

class Payment(db.Model):
    __tablename__ = 'payments'
    id = db.Column(db.Integer, primary_key=True)
    order_id = db.Column(db.Integer, db.ForeignKey('orders.id', ondelete='CASCADE'))
    amount = db.Column(db.Numeric(10, 2), nullable=False)
    method = db.Column(db.String(20), nullable=False)
    status = db.Column(db.String(20), default='pending')
    paid_at = db.Column(db.TIMESTAMP)

# Initialize Flask-Admin
admin = Admin(app, name='FoodExpress Admin', template_mode='bootstrap4')

# Add views for each model (this creates interactive CRUD interfaces)
admin.add_view(ModelView(Customer, db.session))
admin.add_view(ModelView(Restaurant, db.session))
admin.add_view(ModelView(MenuItem, db.session))
admin.add_view(ModelView(DeliveryPartner, db.session))
admin.add_view(ModelView(Order, db.session))
admin.add_view(ModelView(OrderItem, db.session))
admin.add_view(ModelView(Payment, db.session))

# Existing route (updated to use SQLAlchemy)
@app.route("/restaurants", methods=["GET"])
def get_restaurants():
    restaurants = Restaurant.query.all()
    return jsonify([{"id": r.id, "name": r.name, "address": r.address} for r in restaurants])

# Home route to redirect to admin dashboard
@app.route("/")
def home():
    return redirect('/admin')

if __name__ == "__main__":
    # Create tables if they don't exist (based on models)
    with app.app_context():
        db.create_all()
    app.run(debug=True)